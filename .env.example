# AI lead assistant (pages/api/chat.js). Without a key the chat widget shows
# a friendly "offline" message pointing to the contact form.
# Set ONE of these. ANTHROPIC_API_KEY (sk-ant-…) calls Anthropic directly;
# OPENROUTER_API_KEY (sk-or-…) goes through OpenRouter's Anthropic-compatible
# endpoint (same Claude model, no server-side refusal fallbacks).
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Optional: override the model (default: claude-opus-5, or anthropic/claude-opus-5 on OpenRouter)
# ASSISTANT_MODEL=claude-opus-5

# Optional: also POST every captured lead as JSON to a webhook
# (Slack incoming webhook, Zapier, Make, n8n, HubSpot workflow, ...)
# LEAD_WEBHOOK_URL=

# Optional: send assistant leads to a different Formspree form than the
# contact form (defaults to siteMeta.formspreeId in lib/site.js)
# LEAD_FORMSPREE_ID=
